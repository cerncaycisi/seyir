# Copy to keystore.properties (gitignored) and fill in. Never commit the real file or the keystore.
# Create a keystore:  keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
